<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tag/Nacht-Theme: Fenster und Systemleisten in der Fensterfarbe aus values bzw. values-night.
         Die WebView richtet prefers-color-scheme nach dem App-Theme aus; algorithmisches Abdunkeln bleibt aus. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fenster_hintergrund</item>
        <item name="android:statusBarColor">@color/fenster_hintergrund</item>
        <item name="android:navigationBarColor">@color/fenster_hintergrund</item>
        <item name="android:windowLightStatusBar">@bool/helle_systemleisten</item>
        <item name="android:windowLightNavigationBar">@bool/helle_systemleisten</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar" />
</resources>
