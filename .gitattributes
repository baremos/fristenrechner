# Textdateien liegen im Repository mit LF. Die Arbeitskopie folgt dem System.
* text=auto

# Android-Quellen behalten die Zeilenenden der Vorlage; Ausnahmen folgen unten.
app/android/** text eol=lf

# Diese Dateien behalten ihre Zeilenenden auch in der Arbeitskopie.
LICENSE text eol=lf
NOTICE text eol=lf
*.sh text eol=lf
*.py text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Die Referenzdateien des Rechenkerns werden zeichengenau verglichen.
packages/kern/test/referenz/*.txt text eol=lf

# Die Referenzdateien der Oberfläche ebenso.
packages/oberflaeche/test/referenz/** text eol=lf

# Astro kopiert public/ unverändert in die App. Mit festen Zeilenenden sind
# die Builds unter Windows und Linux gleich.
app/public/** text eol=lf

# Capacitor schreibt diese eingecheckten Dateien bei jedem Sync mit LF.
app/android/capacitor.settings.gradle text eol=lf
app/android/app/capacitor.build.gradle text eol=lf

# Feste Zeilenenden der Seitenquellen verhindern Unterschiede im Web-Build.
app/src/** text eol=lf
packages/oberflaeche/src/** text eol=lf

# Übernommene Originaltexte und ihre Prüfsummen brauchen feste Quellbytes.
scripts/hinweistexte/** text eol=lf
# Die zusätzliche Abschlussleerzeile ist Teil der gehashten Quellfassung.
scripts/hinweistexte/libwebp-COPYING.txt whitespace=-blank-at-eof
# Leerzeichen am Zeilenende gehören hier zum unveränderten fremden Wortlaut.
app/src/hinweise-dritter.txt whitespace=-blank-at-eol

# Die Veröffentlichungsrezepte bleiben bytegleich zur fdroiddata-Fassung.
scripts/fdroid/veroeffentlichung/** text eol=lf
# Das Leerzeichen nach Binaries: gehört zur kanonischen Form von fdroid rewritemeta.
scripts/fdroid/veroeffentlichung/de.baremos.fristenrechner.yml whitespace=-blank-at-eol

# Paketmanifeste und Paketbeschreibungen gehen unverändert in die npm-Pakete.
# Mit festen Zeilenenden sind die Archive unter Windows und Linux gleich.
packages/*/package.json text eol=lf
packages/*/README*.md text eol=lf

# Binärdateien
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.pdf binary
*.xlsx binary
*.ttf binary
*.woff2 binary

# Store-Texte im fastlane-Format gehen unverändert an Google Play und F-Droid.
# Nur die Textdateien; Bilder darunter bleiben binär (Regeln oben).
fastlane/metadata/**/*.txt text eol=lf
