---
import Fristenrechner from '@baremos/fristenrechner-ui';
import { webTexte, webExportInhalt } from '@baremos/fristenrechner-ui/ui';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fristenrechner – Browser-Vertragstest</title>
  </head>
  <body>
    <Fristenrechner texte={webTexte} exportInhalt={webExportInhalt} />

    <!-- Der Läufer startet den Vertragstest nach dem Laden der frischen Seite. -->
    <script is:inline src="/vertrag.iife.js"></script>
  </body>
</html>
